# Copy this file to .env and adjust as needed. Every var has a sane default
# for a fresh, single-user install -- you only need to set what you're
# actually changing. workout-app.service points EnvironmentFile at .env
# (not the repo-wide ~/services/.env), so this file is the only place this
# app's own config lives.

# Host/port the backend binds to.
#WORKOUT_APP_HOST=0.0.0.0
#WORKOUT_APP_PORT=8092

# Where the SQLite database lives. Defaults to data/workout.db next to this
# file; created automatically (empty schema, no seed data) on first run.
#WORKOUT_DB_PATH=/path/to/workout.db

# --- Optional add-ons -- the app works fine with all of these left unset ---

# Bodyweight import from a Yazio nutrition-tracking sidecar's own SQLite
# snapshot (see server.py's import-yazio endpoint). If the file doesn't
# exist, that one endpoint just 404s -- nothing else depends on it.
#YAZIO_DB_PATH=/path/to/yazio.db

# Mirrors the full workout history into a Strong-schema CSV on every sync/
# update, for an external analysis pipeline to pick up. Unset (the default)
# disables CSV mirroring entirely -- every sync/update still works, the API
# response's csv_path just comes back null.
#STRONG_EXPORTS_DIR=/path/to/csv/export/dir

# Google Calendar sync (gcal_sync.py): finished/edited/deleted workouts are
# mirrored to a dedicated calendar through a service account that has
# "Make changes to events" on it. Both unset (the default) disables syncing.
# Keep the key file outside git (data/ is gitignored).
#GCAL_KEY_FILE=/path/to/data/calendar-key.json
#GCAL_CALENDAR_ID=<id>@group.calendar.google.com

# Read-only ICS feed of the schedule at /api/calendar/<token>.ics (workout
# name, time and duration only). Unset disables it. Only reachable from
# outside Tailscale if you deliberately expose the backend.
#WORKOUT_ICS_TOKEN=<long random string>
