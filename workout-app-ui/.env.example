# Copy to .env (gitignored; docker compose reads it automatically).
# Everything is optional -- the defaults suit `docker compose --profile full up`.

# Host port the app is published on.
#UI_PORT=8090

# Name of the UI container.
#UI_CONTAINER_NAME=workout-app-data

# Where /api/ is proxied to, as host:port.
#   workout-api:8092            the bundled backend container (default; --profile full)
#   host.docker.internal:8092   backend running directly on this machine
#   nas.local:8092              backend on another machine
#API_UPSTREAM=workout-api:8092
