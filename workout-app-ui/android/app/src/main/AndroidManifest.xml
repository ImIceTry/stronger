<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Active-workout background notification (Open Problem 27 goal 1).
             "specialUse" is the generic Android 14+ foreground-service type
             for cases that aren't location/media/camera/etc; a workout
             timer isn't any of those, so this is the correct fit, not a
             workaround. The property's value is a free-text explanation
             Google reviews for Play-listed apps; irrelevant for this
             sideloaded install but required by the manifest schema either
             way. No serviceType is passed from the JS side, so the plugin
             calls the type-less startForeground() overload, which makes
             Android fall back to this manifest declaration. -->
        <service
            android:name="io.capawesome.capacitorjs.plugins.foregroundservice.AndroidForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the in-progress workout (elapsed time, current exercise) while the app is backgrounded" />
        </service>
        <receiver android:name="io.capawesome.capacitorjs.plugins.foregroundservice.NotificationActionBroadcastReceiver" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Missing permission was the real cause of the notification never
         appearing even after the plugin registration fix: the plugin's own
         ForegroundService.java unconditionally acquires a PARTIAL_WAKE_LOCK
         on every start (acquireWakeLock() calls PowerManager.newWakeLock()
         then wakeLock.acquire()), which throws SecurityException without
         this permission declared; confirmed by reading the plugin's source
         directly, not guessed. (SYSTEM_ALERT_WINDOW, also in the plugin's
         own setup docs, is only used by its separate moveToForeground()
         overlay feature, which this app never calls; left out as dead
         permission.) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
